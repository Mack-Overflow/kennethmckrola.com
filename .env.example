# Only needed if you run the dev.to sync locally. In CI this comes from the DEVTO_API_KEY repo secret.
DEVTO_API_KEY=
NUXT_PUBLIC_SITE_URL=https://kennethmckrola.com
# Optional. Lifts GitHub's 60 req/h anonymous limit when fetching repos + language composition in dev.
# Any fine-grained PAT with public repo read access works. CI uses the built-in GITHUB_TOKEN.
NUXT_GITHUB_TOKEN=
